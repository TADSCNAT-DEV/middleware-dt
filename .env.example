DB_HOST_PORT=5432
MIDDLEWARE_PORT=8000
SIMULATOR_PORT=8001
HOST_IP=10.22.1.247
ALLOWED_HOSTS=localhost,127.0.0.1,*
CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1,http://localhost:8000,https://localhost:8000,https://*.app.github.dev,https://*.github.dev
CODESPACE_NAME=
GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=
# Example (uncomment and set when running in GitHub Codespaces):
# CODESPACE_NAME=my-codespace
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=app.github.dev
# When these are set the services will derive the Codespaces forwarding
# origin in the form:
#   https://<CODESPACE_NAME>-<PORT>.<GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN>
# Add that origin to `CSRF_TRUSTED_ORIGINS` implicitly by setting the two
# vars above and then restarting the affected services:
#   docker compose up -d --no-deps --force-recreate middleware client simulator
# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=middts
POSTGRES_PASSWORD=middts
POSTGRES_DB=middts
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=middts123
NEO4J_URL=neo4j:7687
# Initial Neo4j credentials: neo4j/password; keep password aligned with NEO4J_PASSWORD.
NEO4J_AUTH=neo4j/middts123

# InfluxDB
#Use the scenario admin token
INFLUXDB_INIT_USERNAME=middts
INFLUXDB_INIT_PASSWORD=middts123
INFLUXDB_INIT_ORG=middts
INFLUXDB_INIT_BUCKET=iot_data
INFLUXDB_INIT_ADMIN_TOKEN=middts_token
INFLUXDB_TOKEN=middts_token
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_BUCKET=iot_data
INFLUXDB_ORGANIZATION=middts

USE_INFLUX_TO_EVALUATE=True
ENABLE_INFLUX_LATENCY_MEASUREMENTS=False
DTDL_PARSER_URL=http://parser:8080/api/DTDLModels/parse/

# ThingsBoard credentials (shared)
THINGSBOARD_USER=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant
THINGSBOARD_MQTT_PORT=1883
THINGSBOARD_MQTT_KEEP_ALIVE=60

# Middleware ThingsBoard target
MIDDLEWARE_THINGSBOARD_HOST=demo.thingsboard.io
MIDDLEWARE_TB_HOST=demo.thingsboard.io
MIDDLEWARE_TB_PORT=443
MIDDLEWARE_TB_SCHEME=https

# Middleware listener behavior
START_LISTENER_AFTER_TB=0

# Simulator ThingsBoard target (full URL)
SIMULATOR_THINGSBOARD_HOST=https://demo.thingsboard.io

# Simulator behavior
SIMULATOR_NUMBER=1
HEARTBEAT_INTERVAL=5
RANDOMIZE=1
USE_MEMORY_STATE=1
SIMULATOR_DEBUG=False
SIMULATOR_ALLOWED_HOSTS=*
SIMULATOR_INFLUXDB_BUCKET=iot_data

# Middleware and client superuser (password reapplied on boot).
# Keep client API credentials aligned when changing these values; see docs/demo-make.md.
DJANGO_SUPERUSER_USERNAME=middts
DJANGO_SUPERUSER_PASSWORD=middts123
DJANGO_SUPERUSER_EMAIL=middts@example.com

# Optional simulator bootstrap: current root Compose does NOT forward these variables.
# Use createsuperuser/changepassword as documented in docs/demo-make.md,
# or explicitly forward these variables in a custom Compose with a compatible entrypoint.
SIMULATOR_SUPERUSER_USERNAME=middts
SIMULATOR_SUPERUSER_PASSWORD=middts123
SIMULATOR_SUPERUSER_EMAIL=middts@example.com

# Client authentication to middleware API (match the middleware account above)
MIDDTS_API_USERNAME=middts
MIDDTS_API_PASSWORD=middts123

# Create missing gateways only; preserve existing credentials and active gateway.
# Optional gateway registration in BOTH MiddTS and simulator during make seed-house.
# Requires a simulator version with the devices.GatewayIOT model.
# Use an account API Key, not a device access token or an expiring login JWT.
SEED_THINGSBOARD_GATEWAY=0
THINGSBOARD_GATEWAY_NAME=ThingsBoard Demo
THINGSBOARD_GATEWAY_URL=https://demo.thingsboard.io
THINGSBOARD_AUTH_METHOD=api_key
THINGSBOARD_API_KEY=
# Alternative: THINGSBOARD_AUTH_METHOD=user_password uses THINGSBOARD_USER/PASSWORD.
